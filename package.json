{
  "name": "nst-events",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/ensure-dev-roles.js && turbo run dev",
    "ensure-dev-roles": "node scripts/ensure-dev-roles.js",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "prepare": "husky",
    "validate:local": "turbo run lint typecheck",
    "validate:ci": "turbo run lint typecheck test test:e2e build"
  },
  "devDependencies": {
    "@nst/config": "workspace:*",
    "@types/sinon": "^22.0.0",
    "husky": "9.1.7",
    "prettier": "3.9.6",
    "sinon": "^22.1.0",
    "turbo": "2.10.11",
    "vite": "8.3.5"
  },
  "packageManager": "pnpm@9.0.0",
  "pnpm": {
    "overrides": {
      "typescript": "5.9.3",
      "@types/node": "20.19.43",
      "@types/express": "4.17.25",
      "@types/express-serve-static-core": "4.19.9",
      "@nst/worker>@types/express": "5.0.6",
      "@nst/worker>@types/express-serve-static-core": "5.1.3",
      "proxy-addr": ">=2.0.8",
      "shell-quote": ">=1.11.0",
      "sharp": ">=0.35.5",
      "postcss": ">=8.5.18",
      "nanoid": ">=3.3.18",
      "js-yaml": ">=4.3.2",
      "decode-uri-component": ">=0.5.1",
      "compression": ">=1.8.2",
      "source-map-js": ">=1.2.2",
      "vite": "8.3.5",
      "@nst/worker>zod": "4.6.7",
      "body-parser@1": "1.20.9",
      "body-parser@2": "2.4.0",
      "expo-server-sdk>undici": "7.30.1",
      "undici": "8.12.3",
      "@expo/plist>@xmldom/xmldom": "0.8.15",
      "plist>@xmldom/xmldom": "0.9.12",
      "brace-expansion@1": "1.1.21",
      "brace-expansion@5": "5.0.12",
      "node-forge": ">=1.4.2"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@prisma/client": "5.22.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "jsdom": "^30.0.1",
    "prisma": "5.22.0",
    "vitest": "^4.1.11"
  }
}
