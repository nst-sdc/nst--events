model ResultAuditLog {
  id          String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  resultSetId String               @map("result_set_id") @db.Uuid
  revisionId  String?              @map("revision_id") @db.Uuid
  actorId     String               @map("actor_id") @db.Uuid
  action      String
  reason      String?              @db.Text
  metadata    Json                 @default("{}")
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  resultSet   EventResultSet       @relation(fields: [resultSetId], references: [id], onDelete: Cascade)
  revision    EventResultRevision? @relation(fields: [revisionId], references: [id], onDelete: SetNull)
  actor       User                 @relation(fields: [actorId], references: [id])

  @@index([resultSetId, createdAt])
  @@index([actorId])
  @@map("result_audit_logs")
}

model ResultNotificationOutbox {
  id               String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  resultSetId      String                   @map("result_set_id") @db.Uuid
  revisionId       String                   @map("revision_id") @db.Uuid
  recipientUserId  String                   @map("recipient_user_id") @db.Uuid
  notificationType ResultNotificationType   @map("notification_type")
  idempotencyKey   String                   @unique @map("idempotency_key")
  deliveryStatus   ResultNotificationStatus @default(PENDING) @map("delivery_status")
  attemptCount     Int                      @default(0) @map("attempt_count")
  maxAttempts      Int                      @default(4) @map("max_attempts")
  lastAttemptAt    DateTime?                @map("last_attempt_at") @db.Timestamptz(6)
  lastError        String?                  @map("last_error") @db.Text
  errorCategory    String?                  @map("error_category")
  payload          Json
  createdAt        DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  resultSet        EventResultSet           @relation(fields: [resultSetId], references: [id], onDelete: Cascade)
  revision         EventResultRevision      @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  recipientUser    User                     @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@index([deliveryStatus, attemptCount], map: "result_notification_outbox_status_attempt_idx")
  @@index([resultSetId])
  @@map("result_notification_outbox")
}

model StudentAchievement {
  id                     String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                 String              @map("user_id") @db.Uuid
  eventId                String              @map("event_id") @db.Uuid
  resultSetId            String              @map("result_set_id") @db.Uuid
  revisionId             String              @map("revision_id") @db.Uuid
  awardId                String              @map("award_id") @db.Uuid
  recipientId            String              @map("recipient_id") @db.Uuid
  awardTitle             String              @map("award_title")
  awardType              String              @map("award_type")
  placement              Int?
  isTeamAward            Boolean             @default(false) @map("is_team_award")
  teamId                 String?             @map("team_id") @db.Uuid
  teamNameSnapshot       String?             @map("team_name_snapshot")
  linkedProjectId        String?             @map("linked_project_id") @db.Uuid
  publishedAt            DateTime            @map("published_at") @db.Timestamptz(6)
  isActive               Boolean             @default(true) @map("is_active")
  supersededByRevisionId String?             @map("superseded_by_revision_id") @db.Uuid
  createdAt              DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user                   User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  event                  Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  resultSet              EventResultSet      @relation(fields: [resultSetId], references: [id], onDelete: Cascade)
  revision               EventResultRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  award                  EventAward          @relation(fields: [awardId], references: [id], onDelete: Cascade)
  recipient              AwardRecipient      @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  team                   Team?               @relation(fields: [teamId], references: [id], onDelete: SetNull)
  linkedProject          Project?            @relation(fields: [linkedProjectId], references: [id], onDelete: SetNull)

  @@unique([userId, awardId, revisionId], map: "student_achievements_user_award_revision_key")
  @@index([userId, isActive])
  @@index([eventId, isActive])
  @@map("student_achievements")
}

model ResultReport {
  id              String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  resultSetId     String               @map("result_set_id") @db.Uuid
  revisionId      String               @map("revision_id") @db.Uuid
  reporterId      String?              @map("reporter_id") @db.Uuid
  reason          String
  details         String               @db.Text
  status          ResultReportStatus   @default(PENDING)
  resolutionNotes String?              @map("resolution_notes") @db.Text
  resolvedById    String?              @map("resolved_by_id") @db.Uuid
  resolvedAt      DateTime?            @map("resolved_at") @db.Timestamptz(6)
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  resultSet       EventResultSet       @relation(fields: [resultSetId], references: [id], onDelete: Cascade)
  revision        EventResultRevision  @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  reporter        User?                @relation("ResultReportReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  resolvedBy      User?                @relation("ResultReportResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([resultSetId, status])
  @@map("result_reports")
}

enum ProfileItemType {
  PROJECT
  ACHIEVEMENT
  CLUB
  LINK
}

model StudentProfile {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String    @unique @map("user_id") @db.Uuid
  slug              String    @unique
  headline          String?
  bio               String?   @db.Text
  skills            String[]  @default([])
  interests         String[]  @default([])
  externalLinks     Json      @default("[]") @map("external_links")
  sectionVisibility Json      @default("{\"identity\":true,\"avatar\":true,\"academic\":true,\"bio\":false,\"skills\":false,\"links\":false,\"projects\":false,\"achievements\":false,\"clubs\":false}") @map("section_visibility")
  directoryListed   Boolean   @default(true) @map("directory_listed")
  settingsVersion   Int       @default(1) @map("settings_version")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([directoryListed])
  @@map("student_profiles")
}

model StudentProfileCuratedItem {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String          @map("user_id") @db.Uuid
  itemType     ProfileItemType @map("item_type")
  sourceId     String          @map("source_id")
  isVisible    Boolean         @default(true) @map("is_visible")
  isFeatured   Boolean         @default(false) @map("is_featured")
  displayOrder Int             @default(0) @map("display_order")
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemType, sourceId])
  @@index([userId, itemType])
  @@map("student_profile_curated_items")
}

model StudentSlugHistory {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("student_slug_history")
}
