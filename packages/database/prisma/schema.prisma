generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["views"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                        String                      @id @default(uuid()) @db.Uuid
  googleSub                 String                      @unique @map("google_sub")
  email                     String                      @unique
  fullName                  String                      @map("full_name")
  /// NULL in V1 — file uploads deferred (see database-freeze-v1.md)
  avatarUrl                 String?                     @map("avatar_url")
  globalRole                GlobalRole                  @default(STUDENT) @map("global_role")
  createdAt                 DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  /// / TODO: SQL migration (Status: OPEN)
  updatedAt                 DateTime?                   @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// Soft delete — NULL means active
  deletedAt                 DateTime?                   @map("deleted_at") @db.Timestamptz(6)
  /// Incremented on role/access mutation to immediately invalidate existing JWTs
  securityVersion           Int                         @default(1) @map("security_version")
  announcements             Announcement[]
  disputesReviewed          AttendanceDispute[]         @relation("DisputeReviewedBy")
  disputesFiled             AttendanceDispute[]         @relation("DisputeUser")
  attendanceRecordsAsMarker AttendanceRecord[]          @relation("AttendanceMarkedBy")
  attendanceRecordsAsUser   AttendanceRecord[]          @relation("AttendanceUser")
  sessionsCreated           AttendanceSession[]         @relation("SessionCreatedBy")
  auditLogs                 AuditLog[]
  clubMemberships           ClubMembership[]
  eventRegistrations        EventRegistration[]
  eventResultsCreated       EventResult[]               @relation("EventResultCreatedBy")
  eventResults              EventResult[]               @relation("EventResultUser")
  createdEvents             Event[]                     @relation("EventCreatedBy")
  leaderboardScores         LeaderboardScore[]
  handoverFacultyMentor     LeadershipHandoverRequest[] @relation("HandoverFacultyMentor")
  handoverInitiated         LeadershipHandoverRequest[] @relation("HandoverInitiatedBy")
  handoverSuccessor         LeadershipHandoverRequest[] @relation("HandoverSuccessor")
  notificationPreferences   NotificationPreference?
  notifications             Notification[]
  pushTokens                PushToken[]
  refreshTokens             RefreshToken[]
  teamLeaderships           Team[]
  assignedAcademicProfiles  UserAcademicProfile[]       @relation("AcademicProfileAssignedBy")
  academicProfile           UserAcademicProfile?
  attendanceAttempts        AttendanceAttempt[]
  studentProfileValues      StudentProfileValue[]
  ownedProjects             Project[]                   @relation("ProjectOwner")
  contributedProjects       ProjectContributor[]
  projectLikes              ProjectLike[]
  projectReportsFiled       ProjectReport[]             @relation("ReportedBy")
  projectReportsResolved    ProjectReport[]             @relation("ResolvedBy")
  projectModerationActions  ProjectModerationAction[]
  resultRevisionsCreated    EventResultRevision[]       @relation("ResultRevisionCreatedBy")
  resultRevisionsPublished  EventResultRevision[]       @relation("ResultRevisionPublishedBy")
  resultRevisionsWithdrawn  EventResultRevision[]       @relation("ResultRevisionWithdrawnBy")
  resultRevisionsRestored   EventResultRevision[]       @relation("ResultRevisionRestoredBy")
  awardRecipients           AwardRecipient[]            @relation("RecipientUser")
  awardRecipientMembers     AwardRecipientMember[]      @relation("RecipientMemberUser")
  awardExceptionsAuthorized AwardRecipient[]            @relation("ExceptionAuthorizedBy")
  resultAuditLogs           ResultAuditLog[]
  resultOutboxNotifications ResultNotificationOutbox[]
  studentAchievements       StudentAchievement[]
  resultReportsFiled        ResultReport[]              @relation("ResultReportReporter")
  resultReportsResolved     ResultReport[]              @relation("ResultReportResolvedBy")
  studentProfile            StudentProfile?
  studentCuratedItems       StudentProfileCuratedItem[]
  studentSlugHistory        StudentSlugHistory[]

  @@index([email])
  @@index([googleSub])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  /// SHA-256 hash of raw refresh token. Raw token is never stored.
  tokenHash String    @unique @map("token_hash")
  /// Links rotated tokens together for family-wide revocation.
  familyId  String    @map("family_id") @db.Uuid
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  /// NULL means active. Set on logout or compromise.
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  userAgent String?   @map("user_agent")
  ipAddress String?   @map("ip_address")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([familyId])
  @@map("refresh_tokens")
}

model Club {
  id                      String                      @id @default(uuid()) @db.Uuid
  name                    String                      @unique
  description             String?
  /// NULL in V1 — file uploads deferred (see database-freeze-v1.md)
  bannerUrl               String?                     @map("banner_url")
  status                  ClubStatus                  @default(ACTIVE)
  createdAt               DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime?                   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt               DateTime?                   @map("deleted_at") @db.Timestamptz(6)
  announcements           Announcement[]
  memberships             ClubMembership[]
  eventClubs              EventClub[]
  leaderboardScores       LeaderboardScore[]
  handoverRequests        LeadershipHandoverRequest[]
  createdFieldDefinitions FieldDefinition[]

  @@index([name])
  @@map("clubs")
}

model ClubMembership {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  clubId    String    @map("club_id") @db.Uuid
  role      ClubRole
  joinedAt  DateTime  @default(now()) @map("joined_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  club      Club      @relation(fields: [clubId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@index([clubId, userId])
  @@index([userId])
  @@map("club_memberships")
}

model Event {
  id                    String                    @id @default(uuid()) @db.Uuid
  title                 String
  description           String?
  startTime             DateTime                  @map("start_time") @db.Timestamptz(6)
  endTime               DateTime                  @map("end_time") @db.Timestamptz(6)
  locationName          String?                   @map("location_name")
  /// PostGIS geography point for geofence validation.
  /// PostGIS extension is enabled via docker/init-pgmq.sql on container init.
  /// Access via $queryRaw / $executeRaw with ST_ functions (not via Prisma Client).
  locationGeofence      Unsupported("geography")? @map("location_geofence")
  eventType             EventType                 @map("event_type")
  state                 EventState                @default(DRAFT)
  visibility            EventVisibility?
  slug                  String?                   @unique
  registrationMode      RegistrationMode          @default(REQUIRED) @map("registration_mode")
  registrationType      RegistrationType          @default(INDIVIDUAL) @map("registration_type")
  attendanceType        AttendanceType            @default(SINGLE) @map("attendance_type")
  isLocked              Boolean                   @default(false) @map("is_locked")
  /// NULL means unlimited capacity
  maxCapacity           Int?                      @map("max_capacity")
  /// Maximum participants limit for TEAM events (NULL means unlimited)
  maxParticipants       Int?                      @map("max_participants")
  /// Atomically incremented by register_event RPC
  registrationCount     Int                       @default(0) @map("registration_count")
  registrationStartTime DateTime?                 @map("registration_start_time") @db.Timestamptz(6)
  registrationEndTime   DateTime?                 @map("registration_end_time") @db.Timestamptz(6)
  /// Flexible type-specific metadata (see 08-jsonb-governance.md)
  metadata              Json                      @default("{}")
  createdBy             String                    @map("created_by") @db.Uuid
  createdAt             DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime?                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt             DateTime?                 @map("deleted_at") @db.Timestamptz(6)
  searchVector          Unsupported("tsvector")?  @default(dbgenerated("to_tsvector('english'::regconfig, ((COALESCE(title, ''::text) || ' '::text) || COALESCE(description, ''::text)))")) @map("search_vector")
  audience              EventAudience             @default(ALL_STUDENTS)
  attendanceDisputes    AttendanceDispute[]
  attendanceSessions    AttendanceSession[]
  eventAudienceBatches  EventAudienceBatch[]
  eventClubs            EventClub[]
  eventRegistrations    EventRegistration[]
  eventResults          EventResult[]
  creator               User                      @relation("EventCreatedBy", fields: [createdBy], references: [id])
  teams                 Team[]
  eventFormFields       EventFormField[]
  EventForm             EventForm[]
  slugHistory           EventSlugHistory[]
  resultSet             EventResultSet?
  studentAchievements   StudentAchievement[]

  @@index([startTime])
  @@index([state])
  @@index([searchVector], type: Gin)
  @@map("events")
}

model EventClub {
  eventId   String  @map("event_id") @db.Uuid
  clubId    String  @map("club_id") @db.Uuid
  /// True for the club that holds primary admin rights for the event
  isPrimary Boolean @default(false) @map("is_primary")
  club      Club    @relation(fields: [clubId], references: [id])
  event     Event   @relation(fields: [eventId], references: [id])

  @@id([eventId, clubId])
  @@map("event_clubs")
}

model Team {
  id                                                              String              @id @default(uuid()) @db.Uuid
  eventId                                                         String              @map("event_id") @db.Uuid
  name                                                            String
  leaderId                                                        String              @map("leader_id") @db.Uuid
  createdAt                                                       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt                                                       DateTime?           @map("deleted_at") @db.Timestamptz(6)
  status                                                          TeamStatus          @default(FORMING) @map("status")
  eventRegistrations                                              EventRegistration[]
  event_registrations_event_registrations_team_id_event_idToteams EventRegistration[] @relation("event_registrations_team_id_event_idToteams")
  event                                                           Event               @relation(fields: [eventId], references: [id])
  leader                                                          User                @relation(fields: [leaderId], references: [id])
  normalizedName                                                  String              @map("normalized_name")
  awardRecipients                                                 AwardRecipient[]
  studentAchievements                                             StudentAchievement[]

  @@unique([id, eventId])
  @@unique([eventId, normalizedName])
  @@map("teams")
}

model EventRegistration {
  id                                                String             @id @default(uuid()) @db.Uuid
  eventId                                           String             @map("event_id") @db.Uuid
  userId                                            String             @map("user_id") @db.Uuid
  teamId                                            String?            @map("team_id") @db.Uuid
  registrationStatus                                RegistrationStatus @default(REGISTERED) @map("registration_status")
  participationRole                                 ParticipationRole  @default(ATTENDEE) @map("participation_role")
  registeredAt                                      DateTime           @default(now()) @map("registered_at") @db.Timestamptz(6)
  deletedAt                                         DateTime?          @map("deleted_at") @db.Timestamptz(6)
  event                                             Event              @relation(fields: [eventId], references: [id])
  team                                              Team?              @relation(fields: [teamId], references: [id])
  user                                              User               @relation(fields: [userId], references: [id])
  teams_event_registrations_team_id_event_idToteams Team?              @relation("event_registrations_team_id_event_idToteams", fields: [teamId, eventId], references: [id, eventId], onDelete: NoAction, onUpdate: NoAction, map: "fk_team_event")

  eligibilityScopeSnapshot EventAudience?              @map("eligibility_scope_snapshot")
  academicBatchIdSnapshot  String?                     @map("academic_batch_id_snapshot") @db.Uuid
  responses                EventRegistrationResponse[]
  awardRecipients          AwardRecipient[]
  awardRecipientMembers    AwardRecipientMember[]

  @@index([eventId, userId])
  @@index([userId])
  @@index([teamId, eventId])
  @@map("event_registrations")
}

model AttendanceSession {
  id                 String              @id @default(uuid()) @db.Uuid
  eventId            String              @map("event_id") @db.Uuid
  title              String
  startTime          DateTime            @map("start_time") @db.Timestamptz(6)
  endTime            DateTime            @map("end_time") @db.Timestamptz(6)
  /// Scan window opens at this time
  openAt             DateTime            @map("open_at") @db.Timestamptz(6)
  /// Scan window closes at this time
  closeAt            DateTime            @map("close_at") @db.Timestamptz(6)
  /// Geofence radius in metres (default 50m)
  geofenceRadius     Float               @default(50) @map("geofence_radius")
  /// Latitude of the venue when session was created (immutable)
  venueLatitude      Float?              @map("venue_latitude")
  /// Longitude of the venue when session was created (immutable)
  venueLongitude     Float?              @map("venue_longitude")
  /// Location accuracy of the captured venue in meters
  locationAccuracy   Float?              @map("location_accuracy")
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime?           @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime?           @map("deleted_at") @db.Timestamptz(6)
  /// Cryptographic secret used to generate TOTP QR codes for this session
  qrSecret           String              @map("qr_secret")
  createdBy          String              @map("created_by") @db.Uuid
  attendanceDisputes AttendanceDispute[]
  attendanceRecords  AttendanceRecord[]
  attendanceAttempts AttendanceAttempt[]
  creator            User                @relation("SessionCreatedBy", fields: [createdBy], references: [id])
  event              Event               @relation(fields: [eventId], references: [id])

  @@index([eventId])
  @@map("attendance_sessions")
}

model AttendanceRecord {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId          String              @map("session_id") @db.Uuid
  userId             String              @map("user_id") @db.Uuid
  /// NULL if method = QR (self-scan). Set for MANUAL/SYSTEM marks.
  markedBy           String?             @map("marked_by") @db.Uuid
  markedAt           DateTime            @default(now()) @map("marked_at") @db.Timestamptz(6)
  method             AttendanceMethod
  status             AttendanceStatus
  /// Forensic data for fraud prevention (ADR-030).
  /// Fields: device_id, device_os, gps_accuracy, mock_location_detected, app_version, flagged, flag_reason
  auditMetadata      Json                @default("{}") @map("audit_metadata")
  attendanceDisputes AttendanceDispute[]
  marker             User?               @relation("AttendanceMarkedBy", fields: [markedBy], references: [id])
  session            AttendanceSession   @relation(fields: [sessionId], references: [id])
  user               User                @relation("AttendanceUser", fields: [userId], references: [id])

  @@unique([sessionId, userId])
  @@map("attendance_records")
}

model AttendanceDispute {
  id                     String            @id @default(uuid()) @db.Uuid
  /// NULL if the student has no attendance record (never scanned)
  attendanceRecordId     String?           @map("attendance_record_id") @db.Uuid
  sessionId              String            @map("session_id") @db.Uuid
  eventId                String            @map("event_id") @db.Uuid
  userId                 String            @map("user_id") @db.Uuid
  reason                 String
  evidenceUrls           String[]          @map("evidence_urls")
  status                 DisputeStatus     @default(PENDING)
  disputeWindowExpiresAt DateTime          @map("dispute_window_expires_at") @db.Timestamptz(6)
  submittedAt            DateTime          @default(now()) @map("submitted_at") @db.Timestamptz(6)
  reviewedAt             DateTime?         @map("reviewed_at") @db.Timestamptz(6)
  reviewedBy             String?           @map("reviewed_by") @db.Uuid
  reviewNotes            String?           @map("review_notes")
  createdAt              DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  attendanceRecord       AttendanceRecord? @relation(fields: [attendanceRecordId], references: [id])
  event                  Event             @relation(fields: [eventId], references: [id])
  reviewer               User?             @relation("DisputeReviewedBy", fields: [reviewedBy], references: [id])
  session                AttendanceSession @relation(fields: [sessionId], references: [id])
  user                   User              @relation("DisputeUser", fields: [userId], references: [id])

  @@unique([sessionId, userId])
  @@map("attendance_disputes")
}

model EventResult {
  id         String            @id @default(uuid()) @db.Uuid
  eventId    String            @map("event_id") @db.Uuid
  userId     String            @map("user_id") @db.Uuid
  resultType CompetitionResult @map("result_type")
  createdBy  String            @map("created_by") @db.Uuid
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  creator    User              @relation("EventResultCreatedBy", fields: [createdBy], references: [id])
  event      Event             @relation(fields: [eventId], references: [id])
  user       User              @relation("EventResultUser", fields: [userId], references: [id])

  @@unique([eventId, userId])
  @@map("event_results")
}

model Notification {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  title            String
  body             String
  /// Notification category type (e.g., "EVENT_REMINDER", "CLUB_ANNOUNCEMENT")
  type             String
  readAt           DateTime? @map("read_at") @db.Timestamptz(6)
  /// Routing payload for mobile app (e.g., {screen: "EventDetails", event_id: "..."})
  metadata         Json      @default("{}")
  deliveredAt      DateTime? @map("delivered_at") @db.Timestamptz(6)
  deliveryFailedAt DateTime? @map("delivery_failed_at") @db.Timestamptz(6)
  deliveryError    String?   @map("delivery_error")
  idempotencyKey   String?   @unique @map("idempotency_key")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user             User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, readAt])
  @@map("notifications")
}

model NotificationPreference {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @unique @map("user_id") @db.Uuid
  pushEnabled       Boolean @default(true) @map("push_enabled")
  eventReminders    Boolean @default(true) @map("event_reminders")
  clubAnnouncements Boolean @default(true) @map("club_announcements")
  attendanceAlerts  Boolean @default(true) @map("attendance_alerts")
  user              User    @relation(fields: [userId], references: [id])

  @@map("notification_preferences")
}

model PushToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  /// Client-generated device identifier. Same value used in attendance_records.audit_metadata.
  deviceId   String    @unique @map("device_id")
  /// Expo push token of the form ExponentPushToken[...]
  expoToken  String    @map("expo_token")
  /// 'ios' or 'android'
  platform   String
  /// Updated on each authenticated request to detect stale tokens
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_tokens")
}

model NotificationJob {
  id             String                @id @default(uuid()) @db.Uuid
  status         NotificationJobStatus @default(PENDING)
  payload        Json
  priority       String                @default("NORMAL")
  attemptCount   Int                   @default(0) @map("attempt_count")
  maxAttempts    Int                   @default(4) @map("max_attempts")
  availableAt    DateTime              @default(now()) @map("available_at") @db.Timestamptz(6)
  lockedAt       DateTime?             @map("locked_at") @db.Timestamptz(6)
  workerId       String?               @map("worker_id")
  idempotencyKey String                @unique @map("idempotency_key")
  lastError      String?               @map("last_error")
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  ticketIds      Json?                 @map("ticket_ids")

  @@map("notification_jobs")
}

model Announcement {
  id        String   @id @default(uuid()) @db.Uuid
  /// NULL for global announcements (Platform Admin only)
  clubId    String?  @map("club_id") @db.Uuid
  title     String
  content   String
  createdBy String   @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  club      Club?    @relation(fields: [clubId], references: [id])
  creator   User     @relation(fields: [createdBy], references: [id])

  @@map("announcements")
}

model LeadershipHandoverRequest {
  id              String         @id @default(uuid()) @db.Uuid
  clubId          String         @map("club_id") @db.Uuid
  initiatedBy     String         @map("initiated_by") @db.Uuid
  successorId     String         @map("successor_id") @db.Uuid
  /// NULL if no faculty mentor assigned to the club
  facultyMentorId String?        @map("faculty_mentor_id") @db.Uuid
  status          HandoverStatus @default(PENDING)
  initiatedAt     DateTime       @default(now()) @map("initiated_at") @db.Timestamptz(6)
  reviewedAt      DateTime?      @map("reviewed_at") @db.Timestamptz(6)
  reviewNotes     String?        @map("review_notes")
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  club            Club           @relation(fields: [clubId], references: [id])
  facultyMentor   User?          @relation("HandoverFacultyMentor", fields: [facultyMentorId], references: [id])
  initiator       User           @relation("HandoverInitiatedBy", fields: [initiatedBy], references: [id])
  successor       User           @relation("HandoverSuccessor", fields: [successorId], references: [id])

  @@index([clubId])
  @@map("leadership_handover_requests")
}

model LeaderboardScore {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  /// NULL for user-level scores not tied to a specific club
  clubId    String?  @map("club_id") @db.Uuid
  points    Int
  reason    String
  /// Reference to the source entity (attendance_record id, event_result id, etc.)
  sourceId  String   @map("source_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  club      Club?    @relation(fields: [clubId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([clubId])
  @@index([createdAt], map: "leaderboard_scores_created_at_brin_idx", type: Brin)
  @@map("leaderboard_scores")
}

model AuditLog {
  id            BigInt   @id @default(autoincrement())
  /// NULL indicates a system-level action. Populated by current_user_id() reading app.user_id.
  actorId       String?  @map("actor_id") @db.Uuid
  action        String
  entityType    String   @map("entity_type")
  entityId      String?  @map("entity_id") @db.Uuid
  previousState Json?    @map("previous_state")
  newState      Json?    @map("new_state")
  ipAddress     String?  @map("ip_address")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  actor         User?    @relation(fields: [actorId], references: [id])

  @@index([entityId])
  @@index([actorId])
  @@map("audit_logs")
}

model AcademicProgram {
  id        String          @id @default(uuid()) @db.Uuid
  name      String
  code      String          @unique
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime?       @updatedAt @map("updated_at") @db.Timestamptz(6)
  batches   AcademicBatch[]

  @@map("academic_programs")
}

model AcademicBatch {
  id                   String                @id @default(uuid()) @db.Uuid
  programId            String                @map("program_id") @db.Uuid
  admissionYear        Int                   @map("admission_year")
  graduationYear       Int                   @map("graduation_year")
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime?             @updatedAt @map("updated_at") @db.Timestamptz(6)
  program              AcademicProgram       @relation(fields: [programId], references: [id])
  eventAudienceBatches EventAudienceBatch[]
  profiles             UserAcademicProfile[]

  @@unique([programId, admissionYear, graduationYear])
  @@index([programId])
  @@map("academic_batches")
}

model UserAcademicProfile {
  id               String           @id @default(uuid()) @db.Uuid
  userId           String           @unique @map("user_id") @db.Uuid
  batchId          String           @map("batch_id") @db.Uuid
  assignmentSource AssignmentSource @map("assignment_source")
  assignedBy       String?          @map("assigned_by") @db.Uuid
  assignedAt       DateTime         @default(now()) @map("assigned_at") @db.Timestamptz(6)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime?        @updatedAt @map("updated_at") @db.Timestamptz(6)
  assigner         User?            @relation("AcademicProfileAssignedBy", fields: [assignedBy], references: [id])
  batch            AcademicBatch    @relation(fields: [batchId], references: [id])
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@map("user_academic_profiles")
}

model EventAudienceBatch {
  id        String        @id @default(uuid()) @db.Uuid
  eventId   String        @map("event_id") @db.Uuid
  batchId   String        @map("batch_id") @db.Uuid
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  batch     AcademicBatch @relation(fields: [batchId], references: [id])
  event     Event         @relation(fields: [eventId], references: [id])

  @@unique([eventId, batchId])
  @@map("event_audience_batches")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model spatial_ref_sys {
  srid      Int     @id
  auth_name String? @db.VarChar(256)
  auth_srid Int?
  srtext    String? @db.VarChar(2048)
  proj4text String? @db.VarChar(2048)
}

/// ----------------------------------------------------------------------
/// PUBLIC PROFILE VIEW
/// Exposes non-sensitive user data for general lookup (omits email/google_sub)
/// ----------------------------------------------------------------------
view PublicProfile {
  id         String     @id @db.Uuid
  fullName   String     @map("full_name")
  avatarUrl  String?    @map("avatar_url")
  globalRole GlobalRole @map("global_role")
  createdAt  DateTime   @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime?  @map("updated_at") @db.Timestamptz(6)
  deletedAt  DateTime?  @map("deleted_at") @db.Timestamptz(6)

  @@map("public_profiles")
}

/// The underlying view does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
view geography_columns {
  f_table_catalog    Unsupported("name")?
  f_table_schema     Unsupported("name")?
  f_table_name       Unsupported("name")?
  f_geography_column Unsupported("name")?
  coord_dimension    Int?
  srid               Int?
  type               String?

  @@ignore
}

/// The underlying view does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
view geometry_columns {
  f_table_catalog   String?              @db.VarChar(256)
  f_table_schema    Unsupported("name")?
  f_table_name      Unsupported("name")?
  f_geometry_column Unsupported("name")?
  coord_dimension   Int?
  srid              Int?
  type              String?              @db.VarChar(30)

  @@ignore
}

/// A student authorized by their institutional email domain to access the platform.
/// Exists independently of User to allow pre-authorization before first login.
model AuthorizedStudent {
  id              String          @id @default(uuid()) @db.Uuid
  normalizedEmail String          @unique @map("normalized_email")
  status          DirectoryStatus @default(ACTIVE)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime?       @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy       String?         @map("created_by") @db.Uuid
  updatedBy       String?         @map("updated_by") @db.Uuid

  @@map("authorized_students")
}

/// Ephemeral single-use OAuth authorization codes for mobile exchange.
model MobileAuthCode {
  code      String   @id @db.VarChar(64)
  payload   Json
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([expiresAt])
  @@map("mobile_auth_codes")
}

/// Telemetry log for attendance scan attempts (both rejected and successful)
model AttendanceAttempt {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId      String   @map("session_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  attemptedAt    DateTime @default(now()) @map("attempted_at") @db.Timestamptz(6)
  isSuccess      Boolean  @map("is_success")
  failureReason  String?  @map("failure_reason")
  latitude       Float?
  longitude      Float?
  distanceMeters Float?   @map("distance_meters")
  gpsAccuracy    Float?   @map("gps_accuracy")
  deviceId       String?  @map("device_id")
  deviceOs       String?  @map("device_os")
  appVersion     String?  @map("app_version")
  isOfflineSync  Boolean  @default(false) @map("is_offline_sync")

  session AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionId, isSuccess])
  @@index([userId, attemptedAt])
  @@index([failureReason])
  @@map("attendance_attempts")
}

/// Access status of a user in the student directory.
enum DirectoryStatus {
  ACTIVE
  REVOKED
}

/// Global platform-wide role. Single source of truth for
/// system-level authorization. Do NOT merge with ClubRole.
enum GlobalRole {
  STUDENT
  FACULTY_MENTOR
  FACULTY_ADMIN
  PLATFORM_ADMIN
}

/// Per-club contextual RBAC role. Stored in club_memberships.
/// Do NOT merge with GlobalRole.
enum ClubRole {
  MEMBER
  CORE_MEMBER
  CLUB_ADMIN
  FACULTY_MENTOR
}

/// Operational lifecycle state of a club.
enum ClubStatus {
  ACTIVE
  INACTIVE
  DISSOLVED
}

/// Categorizes the type of event.
/// The metadata JSONB field carries type-specific fields.
enum EventType {
  WORKSHOP
  SEMINAR
  COMPETITION
  MEETUP
  HACKATHON
  OTHER
  CULTURAL
  SPORTS
}

/// Approval and visibility lifecycle of an event.
enum EventState {
  DRAFT
  PENDING_APPROVAL
  PUBLISHED
  ARCHIVED
  CANCELLED
}

/// Whether an event is visible to all, unlisted, or restricted to institutional users.
enum EventVisibility {
  PUBLIC
  UNLISTED
  RESTRICTED
}

model EventSlugHistory {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId   String   @map("event_id") @db.Uuid
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("event_slug_history")
}

enum RegistrationMode {
  REQUIRED
  NOT_REQUIRED
}

/// Whether an event accepts individual or team registrations.
enum RegistrationType {
  INDIVIDUAL
  TEAM
}

enum EventAudience {
  ALL_STUDENTS
  SPECIFIC_BATCHES
}

/// Attendee state within an event registration.
enum RegistrationStatus {
  REGISTERED
  WAITLISTED
  CANCELLED
}

/// Formal record of a user's presence for an attendance session.
/// EXCUSED is written exclusively by the resolve_attendance_dispute
/// RPC when resolution = 'APPROVED'. Never by the QR scan flow.
enum AttendanceStatus {
  PRESENT
  ABSENT
  EXCUSED
}

/// How attendance was recorded.
enum AttendanceMethod {
  QR
  MANUAL
  SYSTEM
}

/// Whether an event requires one check-in or multiple.
enum AttendanceType {
  SINGLE
  MULTI_SESSION
}

/// Contextual role of a registered participant within an event.
enum ParticipationRole {
  ATTENDEE
  VOLUNTEER
  ORGANIZER
  SPEAKER
  MENTOR
}

/// Competition placement outcome, stored in event_results.
enum CompetitionResult {
  WINNER
  RUNNER_UP
  SECOND_RUNNER_UP
  TOP_10
  PARTICIPANT
}

/// State of an attendance dispute request.
enum DisputeStatus {
  PENDING
  APPROVED
  REJECTED
}

/// State of a club leadership handover request.
enum HandoverStatus {
  PENDING
  APPROVED
  REJECTED
}

/// State of a background job in the native PostgreSQL queue.
enum NotificationJobStatus {
  PENDING
  PROCESSING
  WAITING_FOR_RECEIPTS
  COMPLETED
  RETRY_PENDING
  FAILED
  DEAD_LETTER
  ARCHIVED
}

/// Source of the academic batch assignment
enum AssignmentSource {
  INSTITUTIONAL_EMAIL_INFERENCE
  ADMIN_OVERRIDE
}

enum TeamStatus {
  FORMING
  REGISTERED
  WAITLISTED
  CANCELLED
}

/// Field types for custom registration forms
enum FieldType {
  TEXT
  URL
  EMAIL
  NUMBER
  PHONE
  SELECT
  MULTI_SELECT
  RADIO
}

enum FormPurpose {
  REGISTRATION
  SUBMISSION
  FEEDBACK
  CUSTOM
}

model EventForm {
  id          String      @id @default(uuid()) @db.Uuid
  eventId     String      @map("event_id") @db.Uuid
  purpose     FormPurpose
  title       String
  publishedAt DateTime?   @map("published_at") @db.Timestamptz(6)
  releaseAt   DateTime?   @map("release_at") @db.Timestamptz(6)
  closeAt     DateTime?   @map("close_at") @db.Timestamptz(6)
  notifiedAt  DateTime?   @map("notified_at") @db.Timestamptz(6)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  event     Event                       @relation(fields: [eventId], references: [id])
  fields    EventFormField[]
  responses EventRegistrationResponse[]

  @@index([eventId])
  @@index([eventId, publishedAt])
  @@index([releaseAt, notifiedAt])
  @@map("event_forms")
}

/// A shared, cross-club pool of reusable field definitions for event forms.
model FieldDefinition {
  id              String    @id @default(uuid()) @db.Uuid
  key             String    @unique
  label           String
  fieldType       FieldType @map("field_type")
  options         Json?
  isReusable      Boolean   @default(true) @map("is_reusable")
  createdByClubId String?   @map("created_by_club_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  createdInClub              Club?                       @relation(fields: [createdByClubId], references: [id])
  studentProfileValues       StudentProfileValue[]
  eventFormFields            EventFormField[]
  eventRegistrationResponses EventRegistrationResponse[]

  @@map("field_definitions")
}

/// Current saved value per student per reusable field.
model StudentProfileValue {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  fieldDefinitionId String   @map("field_definition_id") @db.Uuid
  value             String
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user            User            @relation(fields: [userId], references: [id])
  fieldDefinition FieldDefinition @relation(fields: [fieldDefinitionId], references: [id])

  @@unique([userId, fieldDefinitionId])
  @@map("student_profile_values")
}

/// Which fields a given event's registration form asks for.
model EventFormField {
  id                String  @id @default(uuid()) @db.Uuid
  eventId           String  @map("event_id") @db.Uuid
  formId            String? @map("form_id") @db.Uuid
  fieldDefinitionId String  @map("field_definition_id") @db.Uuid
  isRequired        Boolean @default(true) @map("is_required")
  order             Int

  event           Event           @relation(fields: [eventId], references: [id])
  eventForm       EventForm?      @relation(fields: [formId], references: [id], onDelete: Cascade)
  fieldDefinition FieldDefinition @relation(fields: [fieldDefinitionId], references: [id])

  // Legacy forms will use a raw SQL partial index: @@unique([eventId, fieldDefinitionId]) WHERE form_id IS NULL
  @@unique([eventId, formId, fieldDefinitionId])
  @@map("event_form_fields")
}

/// The actual submitted answer, frozen per registration.
model EventRegistrationResponse {
  id                  String   @id @default(uuid()) @db.Uuid
  eventRegistrationId String   @map("event_registration_id") @db.Uuid
  formId              String?  @map("form_id") @db.Uuid
  fieldDefinitionId   String   @map("field_definition_id") @db.Uuid
  value               String
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  eventRegistration EventRegistration @relation(fields: [eventRegistrationId], references: [id], onDelete: Cascade)
  eventForm         EventForm?        @relation(fields: [formId], references: [id], onDelete: Restrict)
  fieldDefinition   FieldDefinition   @relation(fields: [fieldDefinitionId], references: [id])

  // Legacy forms will use a raw SQL partial index: @@unique([eventRegistrationId, fieldDefinitionId]) WHERE form_id IS NULL
  @@unique([eventRegistrationId, formId, fieldDefinitionId])
  @@map("event_registration_responses")
}

// =========================================================================
// NST Projects Showcase Models & Enums
// =========================================================================

enum ProjectType {
  PERSONAL
  COURSEWORK
  HACKATHON
  OPEN_SOURCE
  RESEARCH
  HARDWARE
  DESIGN
  CASE_STUDY
}

enum ProjectStatus {
  IDEA
  IN_PROGRESS
  PROTOTYPE
  LIVE
  COMPLETED
  ARCHIVED
}

enum ProjectVisibility {
  DRAFT
  PUBLISHED
  UNPUBLISHED
  REMOVED
}

enum ProjectLinkType {
  DEMO
  REPOSITORY
  VIDEO
  DOCUMENTATION
  OTHER
}

enum ContributorStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum ReportReason {
  PLAGIARISM
  SPAM
  ABUSIVE
  VOTE_MANIPULATION
  MALICIOUS_LINKS
  IP_PRIVACY
  OTHER
}

enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
  DISMISSED
}

enum ModerationActionType {
  HIDE
  RESTORE
  REMOVE
  INVALIDATE_LIKES
  UPDATE_METADATA
}

model Project {
  id                    String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId               String                    @map("owner_id") @db.Uuid
  title                 String
  slug                  String                    @unique
  tagline               String
  description           String                    @db.Text
  problemStatement      String?                   @map("problem_statement") @db.Text
  solution              String?                   @db.Text
  implementationDetails String?                   @map("implementation_details") @db.Text
  personalContribution  String?                   @map("personal_contribution") @db.Text
  whatsNext             String?                   @map("whats_next") @db.Text
  category              String
  tags                  String[]                  @default([])
  projectType           ProjectType               @default(PERSONAL) @map("project_type")
  developmentStatus     ProjectStatus             @default(IN_PROGRESS) @map("development_status")
  visibility            ProjectVisibility         @default(DRAFT)
  publishedAt           DateTime?                 @map("published_at") @db.Timestamptz(6)
  coverImageUrl         String                    @map("cover_image_url")
  galleryImageUrls      String[]                  @default([]) @map("gallery_image_urls")
  likeCount             Int                       @default(0) @map("like_count")
  viewCount             Int                       @default(0) @map("view_count")
  createdAt             DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime?                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt             DateTime?                 @map("deleted_at") @db.Timestamptz(6)

  owner                 User                      @relation("ProjectOwner", fields: [ownerId], references: [id])
  links                 ProjectLink[]
  contributors          ProjectContributor[]
  likes                 ProjectLike[]
  reports               ProjectReport[]
  moderationActions     ProjectModerationAction[]
  slugHistory           ProjectSlugHistory[]
  awardLinks            AwardProjectLink[]
  studentAchievements   StudentAchievement[]

  @@index([ownerId])
  @@index([visibility, publishedAt])
  @@index([category, visibility])
  @@index([deletedAt])
  @@map("projects")
}

model ProjectLink {
  id        String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId String          @map("project_id") @db.Uuid
  type      ProjectLinkType
  label     String?
  url       String
  order     Int             @default(0)
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("project_links")
}

model ProjectContributor {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId    String            @map("project_id") @db.Uuid
  userId       String?           @map("user_id") @db.Uuid
  invitedEmail String?           @map("invited_email")
  role         String
  status       ContributorStatus @default(PENDING)
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime?         @updatedAt @map("updated_at") @db.Timestamptz(6)

  project      Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user         User?             @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
  @@index([invitedEmail])
  @@map("project_contributors")
}

model ProjectLike {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
  @@map("project_likes")
}

model ProjectReport {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId       String        @map("project_id") @db.Uuid
  reporterId      String?       @map("reporter_id") @db.Uuid
  reason          ReportReason
  details         String?       @db.Text
  status          ReportStatus  @default(PENDING)
  resolutionNotes String?       @map("resolution_notes") @db.Text
  resolvedById    String?       @map("resolved_by_id") @db.Uuid
  resolvedAt      DateTime?     @map("resolved_at") @db.Timestamptz(6)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  project         Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reporter        User?         @relation("ReportedBy", fields: [reporterId], references: [id], onDelete: SetNull)
  resolvedBy      User?         @relation("ResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([status])
  @@map("project_reports")
}

model ProjectModerationAction {
  id        String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId String               @map("project_id") @db.Uuid
  actorId   String               @map("actor_id") @db.Uuid
  action    ModerationActionType
  reason    String               @db.Text
  metadata  Json?
  createdAt DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  project   Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor     User                 @relation(fields: [actorId], references: [id])

  @@index([projectId])
  @@index([actorId])
  @@map("project_moderation_actions")
}

model ProjectSlugHistory {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("project_slug_history")
}

// ==========================================
// NST Event Results & Recognition Domain
// ==========================================

enum ResultLifecycleState {
  NOT_CONFIGURED
  DRAFT
  PUBLISHED
  WITHDRAWN
}

enum ResultRevisionStatus {
  DRAFT
  PUBLISHED
  SUPERSEDED
  WITHDRAWN
}

enum AwardType {
  RANKED_PLACEMENT
  SPECIAL_AWARD
  HONORABLE_MENTION
  CUSTOM
}

enum AwardRecipientType {
  INDIVIDUAL
  TEAM
  EXTERNAL
}

enum TieRankingType {
  COMPETITION
  DENSE
}

enum ResultReportStatus {
  PENDING
  REVIEWED
  RESOLVED
  DISMISSED
}

enum ResultNotificationType {
  WINNER_NOTIFICATION
  CORRECTION_NOTIFICATION
  EVENT_ANNOUNCEMENT
}

enum ResultNotificationStatus {
  PENDING
  DELIVERED
  FAILED
  DEAD_LETTER
}

model EventResultSet {
  id                        String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId                   String                @unique @map("event_id") @db.Uuid
  status                    ResultLifecycleState  @default(NOT_CONFIGURED)
  currentDraftRevisionId    String?               @map("current_draft_revision_id") @db.Uuid
  activePublishedRevisionId String?               @map("active_published_revision_id") @db.Uuid
  createdAt                 DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime?             @updatedAt @map("updated_at") @db.Timestamptz(6)

  event                     Event                 @relation(fields: [eventId], references: [id], onDelete: Cascade)
  revisions                 EventResultRevision[]
  auditLogs                 ResultAuditLog[]
  reports                   ResultReport[]
  outboxNotifications       ResultNotificationOutbox[]
  studentAchievements       StudentAchievement[]

  @@map("event_result_sets")
}

model EventResultRevision {
  id               String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  resultSetId      String               @map("result_set_id") @db.Uuid
  revisionNumber   Int                  @map("revision_number")
  status           ResultRevisionStatus @default(DRAFT)
  version          Int                  @default(1)
  createdBy        String               @map("created_by") @db.Uuid
  publishedAt      DateTime?            @map("published_at") @db.Timestamptz(6)
  publishedBy      String?              @map("published_by") @db.Uuid
  correctionReason String?              @map("correction_reason") @db.Text
  withdrawnAt      DateTime?            @map("withdrawn_at") @db.Timestamptz(6)
  withdrawnBy      String?              @map("withdrawn_by") @db.Uuid
  withdrawalReason String?              @map("withdrawal_reason") @db.Text
  restoredAt       DateTime?            @map("restored_at") @db.Timestamptz(6)
  restoredBy       String?              @map("restored_by") @db.Uuid
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime?            @updatedAt @map("updated_at") @db.Timestamptz(6)

  resultSet        EventResultSet       @relation(fields: [resultSetId], references: [id], onDelete: Cascade)
  creator          User                 @relation("ResultRevisionCreatedBy", fields: [createdBy], references: [id])
  publisher        User?                @relation("ResultRevisionPublishedBy", fields: [publishedBy], references: [id])
  withdrawer       User?                @relation("ResultRevisionWithdrawnBy", fields: [withdrawnBy], references: [id])
  restorer         User?                @relation("ResultRevisionRestoredBy", fields: [restoredBy], references: [id])
  awards           EventAward[]
  auditLogs        ResultAuditLog[]
  reports          ResultReport[]
  outboxNotifications ResultNotificationOutbox[]
  studentAchievements StudentAchievement[]

  @@unique([resultSetId, revisionNumber])
  @@index([resultSetId, status])
  @@map("event_result_revisions")
}

model EventAward {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  revisionId     String          @map("revision_id") @db.Uuid
  title          String
  awardType      AwardType       @default(RANKED_PLACEMENT) @map("award_type")
  placement      Int?
  description    String?         @db.Text
  prizeDetails   String?         @map("prize_details") @db.Text
  displayOrder   Int             @default(0) @map("display_order")
  isTied         Boolean         @default(false) @map("is_tied")
  tieRankingType TieRankingType? @map("tie_ranking_type")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime?       @updatedAt @map("updated_at") @db.Timestamptz(6)

  revision       EventResultRevision  @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  recipients     AwardRecipient[]
  projectLinks   AwardProjectLink[]
  studentAchievements StudentAchievement[]

  @@index([revisionId, displayOrder])
  @@map("event_awards")
}

model AwardRecipient {
  id                    String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  awardId               String              @map("award_id") @db.Uuid
  recipientType         AwardRecipientType  @map("recipient_type")
  userId                String?             @map("user_id") @db.Uuid
  registrationId        String?             @map("registration_id") @db.Uuid
  teamId                String?             @map("team_id") @db.Uuid
  externalName          String?             @map("external_name")
  externalDetails       String?             @map("external_details") @db.Text
  isAuthorizedException Boolean             @default(false) @map("is_authorized_exception")
  exceptionReason       String?             @map("exception_reason") @db.Text
  exceptionAuthorizedBy String?             @map("exception_authorized_by") @db.Uuid
  createdAt             DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  award                 EventAward          @relation(fields: [awardId], references: [id], onDelete: Cascade)
  user                  User?               @relation("RecipientUser", fields: [userId], references: [id], onDelete: SetNull)
  exceptionAuthorizer   User?               @relation("ExceptionAuthorizedBy", fields: [exceptionAuthorizedBy], references: [id], onDelete: SetNull)
  registration          EventRegistration?  @relation(fields: [registrationId], references: [id], onDelete: SetNull)
  team                  Team?               @relation(fields: [teamId], references: [id], onDelete: SetNull)
  members               AwardRecipientMember[]
  studentAchievements   StudentAchievement[]

  @@index([awardId])
  @@index([userId])
  @@index([teamId])
  @@map("award_recipients")
}

model AwardRecipientMember {
  id                    String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipientId           String             @map("recipient_id") @db.Uuid
  userId                String?            @map("user_id") @db.Uuid
  registrationId        String?            @map("registration_id") @db.Uuid
  displayNameSnapshot   String             @map("display_name_snapshot")
  avatarUrlSnapshot     String?            @map("avatar_url_snapshot")
  rollNumberSnapshot    String?            @map("roll_number_snapshot")
  teamRoleSnapshot      String?            @map("team_role_snapshot")
  isAuthorizedException Boolean            @default(false) @map("is_authorized_exception")
  exceptionReason       String?            @map("exception_reason") @db.Text
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  recipient             AwardRecipient     @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  user                  User?              @relation("RecipientMemberUser", fields: [userId], references: [id], onDelete: SetNull)
  registration          EventRegistration? @relation(fields: [registrationId], references: [id], onDelete: SetNull)

  @@index([recipientId])
  @@index([userId])
  @@map("award_recipient_members")
}

model AwardProjectLink {
  id                   String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  awardId              String     @map("award_id") @db.Uuid
  projectId            String?    @map("project_id") @db.Uuid
  externalProjectUrl   String?    @map("external_project_url")
  projectTitleSnapshot String?    @map("project_title_snapshot")
  createdAt            DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  award                EventAward @relation(fields: [awardId], references: [id], onDelete: Cascade)
