{
  "name": "@nst/database",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "prisma generate && tsc --module CommonJS --outDir dist",
    "dev": "echo 'Prisma dev stub'",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:validate": "prisma validate",
    "test:e2e": "ts-node --project tsconfig.seed.json tests/schema.test.ts",
    "bootstrap-admin": "node --no-warnings scripts/bootstrap-platform-admin.ts"
  },
  "dependencies": {
    "@prisma/client": "5.22.0"
  },
  "devDependencies": {
    "@nst/config": "workspace:*",
    "@types/node": "26.2.0",
    "prisma": "5.22.0",
    "ts-node": "10.9.2",
    "typescript": "7.0.2"
  }
}
