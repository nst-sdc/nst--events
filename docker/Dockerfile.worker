# Multi-stage Dockerfile for @nst/worker
FROM node:20-alpine AS builder
WORKDIR /app
RUN apk add --no-cache openssl
RUN corepack enable && corepack prepare pnpm@9.0.0 --activate
COPY . .
# Lower network concurrency + retries: Alpine/musl's resolver intermittently
# times out (EAI_AGAIN) under pnpm's default parallel fetches.
RUN pnpm install --frozen-lockfile \
      --network-concurrency=4 \
      --fetch-retries=5 \
      --fetch-retry-mintimeout=20000 \
      --fetch-retry-maxtimeout=120000
RUN pnpm --filter @nst/worker... build

FROM node:20-alpine AS runner
WORKDIR /app
RUN apk add --no-cache openssl
ENV NODE_ENV=production
COPY --chown=node:node --from=builder /app ./
EXPOSE 3002
CMD ["sh", "-c", "DATABASE_URL=\"${DATABASE_URL:-$WORKER_DATABASE_URL}\" exec node apps/worker/dist/src/index.js"]
