# ==========================================
# NST Events Mobile Environment Variables
# ==========================================

# API URL (use localhost for local emulator/simulator testing)
EXPO_PUBLIC_API_URL=http://localhost:3001

# Production fallback API URL (used when running non-DEV standalone builds)
EXPO_PUBLIC_PROD_API_URL=https://api.nst-events.nstsdc.org

# Google OAuth Client IDs
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=placeholder-google-web-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=placeholder-google-ios-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=placeholder-google-android-client-id.apps.googleusercontent.com

# Support & Policy Links
EXPO_PUBLIC_SUPPORT_EMAIL=events-support@adypu.edu.in
EXPO_PUBLIC_PRIVACY_POLICY_URL=https://adypu.edu.in/privacy-policy
